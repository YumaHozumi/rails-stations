<img src=<%= @movie.image_url %>>
<h1>公開中</h1>
<p><%= @movie.name %></p>

<%= @movie.year %>

<%= form_with  url: {action: "reservation"}, method: :get do |form| %>
    <%= form.select :date, 7.times.map {|i| Date.today + i}, include_blank: true %>
    <%= form.select :schedule_id, @schedules.map { |schedule| [schedule.showing_time, schedule.id]}, include_blank: true %>
    <%= form.submit "test", name: nil%>
<% end %>

<h1>概要</h1>
<%= @movie.description %>

<h1>上映スケジュール</h1>
<% @schedules.each do |schedule| %>
    <div>
        <%= schedule.showing_time %>
    </div>
<% end %>