<img src=<%= @movie.image_url %>>
<h1>公開中</h1>
<p><%= @movie.name %></p>

<%= @movie.year %>

<%= form_with  method: :get do |form| %>
    <%= form.select :selected_time, 7.times.map {|i| Date.today + i}, onchange: "this.form.submit();" %>
    
    <%= form.submit "test"%>
<% end %>

<h1>概要</h1>
<%= @movie.description %>

<h1>上映スケジュール</h1>
<% @schedules.each do |schedule| %>
    はじまり<%= schedule.format_time(schedule.start_time) %>
    〜
    おわり<%= schedule.format_time(schedule.end_time) %>
<% end %>