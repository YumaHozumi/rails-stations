<%= form_with method: :get, local: true do |form| %>
    <%= form.text_field :keyword %>
    <%= form.radio_button :is_showing, "all" %>
    <%= form.label :all, "全て" %>
    <%= form.radio_button :is_showing, "showing" %>
    <%= form.label :showing, "公開中" %>
    <%= form.radio_button :is_showing, "scheduled" %>
    <%= form.label :scheduled, "公開予定" %>
    
    <%= form.submit "検索", name: nil %>
<% end %>

<div id="movies">
    <table border=1>
        <tr>
            <th>ID</th>
            <th>映画タイトル</th>
            <th>公開年</th>
            <th>上映中か</th>
            <th>概要</th>
            <th>画像URL</th>
            <th>作成日時</th>
            <th>更新日時</th>
        </tr>
        <% @movies.each do |movie| %>
            <tr>
                <th><%= movie.id %></th>
                <th><%= movie.name %></th>
                <th><%= movie.year%></th>
                <th>
                    <% if movie.is_showing %>
                        上映中
                    <% else %>
                        上映予定
                    <% end %>
                </th>
                <th><%= movie.description %></th>
                <th><%= movie.image_url %></th>
                <th><time><%= movie.created_at %></time></th>
                <th><%= movie.updated_at %></th>
            </tr>
        <% end %>
    </table>

</div>