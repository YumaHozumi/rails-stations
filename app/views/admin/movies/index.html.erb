<h1>管理画面</h1>

<div id="movies">
    <table border=1>
        <tr>
            <th>ID</th>
            <th>映画タイトル</th>
            <th>公開年</th>
            <th>上映中か</th>
            <th>概要</th>
            <th>画像URL</th>
            <th>作成日時</th>
            <th>更新日時</th>
        </tr>
        <% @movies.each do |movie| %>
            <tr>
                <th><%= link_to movie.id, edit_admin_movie_path(movie.id) %></th>
                <th><%= movie.name %></th>
                <th><%= movie.year%></th>
                <th>
                    <% if movie.is_showing %>
                        上映中
                    <% else %>
                        上映予定
                    <% end %>
                </th>
                <th><%= movie.description %></th>
                <th><img src=<%= movie.image_url %>></th>
                <th><time><%= movie.created_at %></time></th>
                <th><%= movie.updated_at %></th>
            </tr>
        <% end %>
    </table>

    <h1>上映一覧</h1>
    <table border=1>
        <tr>
            <th>ID</th>
            <th>映画名</th>
            <th>開始時刻</th>
            <th>終了時刻</th>
            <th>作成日時</th>
            <th>更新日時</th>
        </tr>
    <% @schedules.each do |schedule| %>
        <th><%= schedule.id %></th>
        <th><%= schedule.start_time %></th>
    <% end %>

    </table>
</div>