<h1>編集画面</h1>

<%= form_with model: [:admin, @movie], method: :put do |form| %>

    <% if flash[:alert] %>
        <%= flash[:alert] %>
    <% end %>
    <br>

    <%= form.label :name, "映画タイトル" %>
    <%= form.text_field :name %>

    <%= form.label :year, "公開年" %>
    <%= form.text_field :year %>

    <%= form.label :description, "概要" %>
    <%= form.text_area :description %>

    <%= form.label :is_showing, "上映中か" %>
    <%= form.select :is_showing, [['公開中',1],['上映予定',0]] %>

    <%= form.label :image_url, "画像URL" %>
    <%= form.text_field :image_url %>

    <%= form.submit "更新" %>
<% end %>

<%= button_to "削除", admin_movie_path(@movie), method: :delete, form: {data: { turbo_confirm: "Are you sure?" }} %>
