<% if flash[:alert] %>
    <%= flash[:alert] %>
<% end %>

<table>
    <tr>
        <th>ID</th>
        <th>映画タイトル</th>
        <th>sheet_id</th>
        <th>日時</th>
        <th>名前</th>
        <th>メールアドレス</th>
        <th>作成日時</th>
        <th>更新日時</th>
    </tr>
    
        <% @reservations.each do | reservation | %>
        <tr>
            <td><%= link_to reservation.id, admin_reservation_path(reservation.id) %></td>
            <td><%= reservation.schedule.movie.name %></td>
            <td><%= reservation.sheet_id %></td>
            <td><%= reservation.date %></td>
            <td><%= reservation.name %></td>
            <td><%= reservation.email %></td>
            <td><%= reservation.created_at %></td>
            <td><%= reservation.updated_at %></td>
        </tr>
    <% end %>
</table>
